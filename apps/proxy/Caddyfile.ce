{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory} 
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		# No default on purpose: with 0.0.0.0/0 Caddy trusted the
		# X-Forwarded-For of any client, so anyone could choose the IP the
		# application logs and rate-limits on. Empty here is fail-closed --
		# no proxy is trusted -- and docker-compose-orca.yml makes the
		# variable required so a deployment cannot land in that state by
		# accident. Set it to the CIDR of the proxy in front of Caddy.
		trusted_proxies static {$TRUSTED_PROXIES}
	}
}

(plane_proxy) {
	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}

	# Compression and static-asset caching. A PaaS usually puts its own edge
	# proxy in front of this one and does both; a plain `docker compose up` on
	# a VM has nothing in front, so Caddy is the edge and has to do them here.
	#
	# The service images serve their bundles uncompressed, and the web bundle
	# alone is ~33 MB across ~1100 files. Measured on the internal 4UM VM over
	# a ~1 MB/s link: the largest chunk went from 1.9 MB to 642 KB, and from
	# 1.9-7.9 s to 1.1 s.
	#
	# `*/assets/*` is the Vite output directory of web, admin and space, where
	# every filename already carries a content hash -- so the response is
	# immutable by construction and revalidating it on every tab is pure
	# round-trips. Nothing else is cached: `immutable` on an unhashed path
	# would pin a stale file for a year.
	encode zstd gzip
	@assets path */assets/*
	header @assets >Cache-Control "public, max-age=31536000, immutable"

  redir /spaces /spaces/ permanent
	reverse_proxy /spaces/* space:3000

  redir /god-mode /god-mode/ permanent
	reverse_proxy /god-mode/* admin:3000
	
	reverse_proxy /live/* live:3000

	reverse_proxy /api/* api:8000

	reverse_proxy /auth/* api:8000

	reverse_proxy /static/* api:8000

	reverse_proxy /{$BUCKET_NAME}/* plane-minio:9000
	reverse_proxy /{$BUCKET_NAME} plane-minio:9000

	reverse_proxy /* web:3000
}

{$SITE_ADDRESS} {
	import plane_proxy
}