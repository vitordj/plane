{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory} 
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		# No default on purpose. This list decides whose X-Forwarded-For
		# Caddy believes, and the application reads the leftmost entry of
		# that header as the client IP (plane/utils/ip_address.py), so
		# `0.0.0.0/0` here let any caller pick the IP that rate limiting and
		# the authentication log would record. Empty means no proxy is
		# trusted: forged headers are dropped, and every request looks like
		# it came from the proxy in front. Set it to the real CIDR of that
		# proxy; docker-compose-orca.yml refuses to start without it.
		trusted_proxies static {$TRUSTED_PROXIES}
	}
}

(plane_proxy) {
	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}

  redir /spaces /spaces/ permanent
	reverse_proxy /spaces/* space:3000

  redir /god-mode /god-mode/ permanent
	reverse_proxy /god-mode/* admin:3000
	
	reverse_proxy /live/* live:3000

	reverse_proxy /api/* api:8000

	reverse_proxy /auth/* api:8000

	reverse_proxy /static/* api:8000

	reverse_proxy /{$BUCKET_NAME}/* plane-minio:9000
	reverse_proxy /{$BUCKET_NAME} plane-minio:9000

	reverse_proxy /* web:3000
}

{$SITE_ADDRESS} {
	import plane_proxy
}