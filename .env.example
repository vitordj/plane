# Database Settings
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_DB="plane"
PGDATA="/var/lib/postgresql/data"

# Redis Settings
REDIS_HOST="plane-redis"
REDIS_PORT="6379"

# RabbitMQ Settings
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit
FILE_SIZE_LIMIT=5242880

# GPT settings
OPENAI_API_BASE="https://api.openai.com/v1" # deprecated
OPENAI_API_KEY="sk-" # deprecated
GPT_ENGINE="gpt-3.5-turbo" # deprecated

# Settings related to Docker
DOCKERIZED=1  # deprecated

# set to 1 If using the pre-configured minio setup
USE_MINIO=1

# If SSL Cert to be generated, set CERT_EMAIl="email <EMAIL_ADDRESS>"
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# Required. CIDR range of the proxy in front of Plane (Coolify, ALB, Cloudflare
# tunnel...), comma-separated. Only these sources may set X-Forwarded-For;
# leaving it empty stops the proxy at boot rather than trusting everyone.
# Example: 10.0.0.0/8
TRUSTED_PROXIES=
SITE_ADDRESS=:80
CERT_EMAIL=

# For DNS Challenge based certificate generation, set the CERT_ACME_DNS, CERT_EMAIL
# CERT_ACME_DNS="acme_dns <CERT_DNS_PROVIDER> <CERT_DNS_PROVIDER_API_KEY>"
CERT_ACME_DNS=

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"
# Per-workspace rate limit for the SCIM provisioning endpoints. Entra sends one
# request per user and per membership change, so a first sync of a large
# directory is a long burst; raise this if Entra reports 429 responses.
SCIM_RATE_LIMIT="600/minute"

# Interface language the instance falls back to: new members start in it, and
# the sign-in, sign-up and public pages render in it. Must be one of the
# catalogue's locale codes (en, fr, es, ja, zh-CN, zh-TW, ru, it, cs, sk, de,
# ua, pl, ko, pt-BR, id, ro, vi-VN, tr-TR); anything else is read as "en".
# Only seeds the setting on first boot — after that it is edited in god-mode
# under Settings -> General, and this variable is ignored. See docs/i18n.md.
DEFAULT_LANGUAGE="en"

# Migration Settings
MIGRATION_OLD_PLANE_URL="https://your-old-plane-domain.com"
MIGRATION_OLD_API_TOKEN="your-old-api-token"
MIGRATION_OLD_WORKSPACE_SLUG="your-old-workspace-slug"

MIGRATION_NEW_PLANE_URL="https://your-new-orca-domain.com"
MIGRATION_NEW_API_TOKEN="your-new-api-token"
MIGRATION_NEW_WORKSPACE_SLUG="your-new-workspace-slug"

# Orca: the public automation API under /api/v1/orca/. Off by default, and it
# stays off in production until an area has a coordinator watching its queue —
# it lets a robot create work and hand it to a person.
ORCA_PUBLIC_API_ENABLED=0
# Per-token rate limit for that API.
ORCA_PUBLIC_API_RATE_LIMIT=300/minute

# Orca: holidays, leave and per-area "no new work for now". Off by default —
# with it off everybody counts as available and the ranking behaves as it did
# before the feature existed.
ORCA_AVAILABILITY_ENABLED=0
